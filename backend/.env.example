# ==========================================
# Backend environment template.
# Copy the repo-root `requirements`-driven keys from ../../.env.example
# into your repo-root `.env` (gitignored). This file is only documentation.
# ==========================================

# MongoDB Atlas connection string (your cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB=solutionforge

# JWT secret for login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# Cohere LLM key (powers the CrewAI agents)
COHERE_API_KEY=

# Serper.dev key (web search for agents)
SERPER_API_KEY=